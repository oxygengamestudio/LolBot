{
  "name": "lolbot",
  "version": "1.0.9",
  "description": "Bot Discord de musique bilingue avec pipeline vocal durci",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "DISCORD_TOKEN=test-token DISCORD_CLIENT_ID=test-client DISCORD_GUILD_ID=test-guild GOOGLE_API_KEY=test-key LOG_LEVEL=ERROR NODE_ENV=test node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "node scripts/dev-watch.mjs",
    "register": "tsx src/register-commands.ts",
    "stress:single": "tsx scripts/stress-single-instance.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.10",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "undici": "^6.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
