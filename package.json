{
  "name": "lolbot",
  "version": "1.0.9",
  "description": "Bot Discord de musique bilingue avec pipeline vocal durci",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "doctor": "node dist/doctor.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test",
    "test:coverage": "node --import tsx --experimental-test-coverage --test",
    "start": "node dist/index.js",
    "dev": "node scripts/dev-watch.mjs",
    "register": "tsx src/register-commands.ts",
    "stress:single": "tsx scripts/stress-single-instance.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.11",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "tar": "^7.5.20",
    "undici": "^6.27.0",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
