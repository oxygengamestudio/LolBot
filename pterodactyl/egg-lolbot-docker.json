{
  "_comment": "LolBot Docker egg for Pterodactyl. Import this egg, then create the server manually from the panel.",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-05-23T00:00:00+00:00",
  "name": "LolBot Docker",
  "author": "admin@oxygengamestudio.com",
  "description": "Discord music bot running from the prebuilt GHCR Docker image.",
  "features": [],
  "docker_images": {
    "ghcr.io/oxygengamestudio/lolbot:preprod": "ghcr.io/oxygengamestudio/lolbot:preprod"
  },
  "startup": "node /app/dist/index.js",
  "config": {
    "files": "{}",
    "startup": "{}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/ash\nmkdir -p /mnt/server/data\nexit 0",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Discord Token",
      "description": "Discord bot token for this environment. Rotate any token that was pasted in chat.",
      "env_variable": "DISCORD_TOKEN",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:4096",
      "field_type": "text"
    },
    {
      "name": "Discord Client ID",
      "description": "Discord application client id.",
      "env_variable": "DISCORD_CLIENT_ID",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:32",
      "field_type": "text"
    },
    {
      "name": "Discord Guild ID",
      "description": "Optional guild id for instant slash command registration.",
      "env_variable": "DISCORD_GUILD_ID",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:32",
      "field_type": "text"
    },
    {
      "name": "Google API Key",
      "description": "Optional Google/YouTube API key. The bot falls back to yt-dlp if this is empty or quota-limited.",
      "env_variable": "GOOGLE_API_KEY",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:4096",
      "field_type": "text"
    },
    {
      "name": "Data Directory",
      "description": "Persistent data directory inside the Pterodactyl container.",
      "env_variable": "DATA_DIR",
      "default_value": "/home/container/data",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:255",
      "field_type": "text"
    },
    {
      "name": "Log Level",
      "description": "Runtime log verbosity.",
      "env_variable": "LOG_LEVEL",
      "default_value": "INFO",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|in:NONE,ERROR,WARN,INFO,DEBUG,TRACE",
      "field_type": "text"
    },
    {
      "name": "Node Environment",
      "description": "Node runtime environment.",
      "env_variable": "NODE_ENV",
      "default_value": "production",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|in:development,test,production",
      "field_type": "text"
    }
  ]
}
